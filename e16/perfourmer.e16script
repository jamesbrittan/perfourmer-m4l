--@assign id=16 abbr="E16"  name="Encoder 16"    desc="Encoder 16"           manual=true g=16
--@assign id=32 abbr="E16"  name="Enc 16 Push"   desc="Encoder 16 Push"      p=true      g=16

-- Perfourmer Hub <-> OXI E16 Controller Script
--
-- Protocol:
--   Turn: Relative CC on Channel 16 (0-indexed 15), CC 20-35 (65=+1, 63=-1)
--   Push: CC on Channel 16, CC 40-55 (127 on press)
--   Page: CC on Channel 16, CC 119 (0-11)
--   SysEx: F0 00 7F 7F 01 <enc 0-15 or 7F> <ring 0-127> <r> <g> <b> <c0-c3> F7

local MIDI_CH      = 15    -- MIDI channel 16 (0-indexed: 0-15)
local ENC_CC_BASE  = 20    -- first encoder CC
local PUSH_CC_BASE = 40    -- first push CC
local PAGE_CC      = 119   -- page-change CC

local function send_cc(ch, cc, val)
  midi.sendCC(0, ch, cc, val)
  midi.sendCC(3, ch, cc, val)
end

function page.onInit()
  page.setTitle("PF4 Hub")
  -- Request initial values from Hub by announcing page 0
  send_cc(MIDI_CH, PAGE_CC, 0)
end

function controller.onEncoderTurn(enc)
  local enc_num = 0
  if enc.id and enc.id >= 1 and enc.id <= 16 then
    enc_num = enc.id - 1
  elseif enc.index and enc.index >= 1 and enc.index <= 16 then
    enc_num = enc.index - 1
  end

  local delta = enc.increment or 0
  if delta == 0 then return end

  -- Relative CC: 65 = +1, 63 = -1, 66 = +2, etc.
  local cc_val = 64 + delta
  if cc_val < 0 then cc_val = 0 end
  if cc_val > 127 then cc_val = 127 end

  send_cc(MIDI_CH, ENC_CC_BASE + enc_num, cc_val)
end

function controller.onEncoderPress(enc)
  local enc_num = 0
  if enc.id and enc.id >= 17 and enc.id <= 32 then
    enc_num = enc.id - 17
  elseif enc.id and enc.id >= 1 and enc.id <= 16 then
    enc_num = enc.id - 1
  elseif enc.index and enc.index >= 1 and enc.index <= 16 then
    enc_num = enc.index - 1
  end

  send_cc(MIDI_CH, PUSH_CC_BASE + enc_num, 127)
end

function page.onPageChange(prev, curr)
  for i = 1, 16 do
    leds.reset(i)
    slots.reset(i)
  end
  if curr then
    send_cc(MIDI_CH, PAGE_CC, curr - 1)
  end
end

function controller.onSysex(bytes)
  -- SysEx framing: F0 00 7F 7F 01 <enc> <ring> <r> <g> <b> <c0> <c1> <c2> <c3> F7
  if not bytes or #bytes < 15 then return end
  if bytes[1] ~= 0xF0 or bytes[2] ~= 0x00 or bytes[3] ~= 0x7F or bytes[4] ~= 0x7F or bytes[5] ~= 0x01 then
    return
  end
  if bytes[#bytes] ~= 0xF7 then return end

  local enc  = bytes[6]
  local ring = bytes[7]
  local r    = bytes[8]
  local g    = bytes[9]
  local b    = bytes[10]
  local label = string.char(bytes[11], bytes[12], bytes[13], bytes[14])

  if enc == 0x7F then
    page.setTitle(label)
  elseif enc >= 0 and enc < 16 then
    local slot = enc + 1
    slots.update(slot, label)

    -- LED ring position (0-127 -> 0-16383)
    local ring_val = (ring * 16383) // 127

    -- Color mapping
    local color = 10
    if r > 80 and g < 40 then
      color = 80
    elseif b > 80 then
      color = 60
    elseif g > 80 then
      color = 20
    elseif r < 40 and g < 40 and b < 40 then
      color = 0
    end

    leds.update(slot, ring_val, color)
  end
end
