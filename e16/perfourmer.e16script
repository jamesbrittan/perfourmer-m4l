--@assign id=32 abbr="Rate" name="L4 Rate P" desc="Lane 4 Rate P" p=true      g=16

-- Perfourmer Hub <-> OXI E16 Controller Script
--
-- Protocol:
--   Turn: Relative CC on Channel 1 (0-indexed 0), CC 20-35 (65=+1, 63=-1)
--   Push: CC on Channel 1, CC 40-55 (127 on press)
--   Page: CC on Channel 1, CC 119 (0-11)
--   SysEx: F0 00 7F 7F 01 <enc 0-15 or 7F> <ring 0-127> <colour 0-100> <unused> <unused> <c0-c3> F7

local VERSION      = "v6"  -- shown in the page title, to check which script the E16 is running
local MIDI_CH      = 0     -- MIDI channel 1 (0-indexed); output 3 sent channel 1 even when asked for 16
local ENC_CC_BASE  = 20    -- first encoder CC
local PUSH_CC_BASE = 40    -- first push CC
local PAGE_CC      = 119   -- page-change CC

-- Output 3 is the one that reaches the computer over USB; output 0 ("all outputs" in the API doc) didn't in testing.
-- Send on one output only, so each click arrives once.
local CC_OUT = 3

local function send_cc(ch, cc, val)
  midi.sendCC(CC_OUT, ch, cc, val)
end

function page.onInit()
  page.setTitle("PF4 Hub " .. VERSION)
  -- Request initial values from Hub by announcing page 0
  send_cc(MIDI_CH, PAGE_CC, 0)
end

function controller.onEncoderTurn(enc)
  local enc_num
  if enc.index and enc.index >= 1 and enc.index <= 16 then
    enc_num = enc.index - 1
  elseif enc.id and enc.id >= 1 and enc.id <= 16 then
    enc_num = enc.id - 1
  end
  if not enc_num then return end  -- not one of ours

  local inc = enc.increment or 0
  if inc == 0 then return end

  -- Clamp delta to strictly +/-1 per click to guarantee 1 click = 1 value step
  local delta = (inc > 0) and 1 or -1

  -- Relative CC: 65 = +1, 63 = -1
  local cc_val = 64 + delta

  send_cc(MIDI_CH, ENC_CC_BASE + enc_num, cc_val)
end

function controller.onEncoderPress(enc)
  local enc_num
  if enc.index and enc.index >= 1 and enc.index <= 16 then
    enc_num = enc.index - 1
  elseif enc.id and enc.id >= 17 and enc.id <= 32 then
    enc_num = enc.id - 17
  elseif enc.id and enc.id >= 1 and enc.id <= 16 then
    enc_num = enc.id - 1
  end
  if not enc_num then return end  -- not one of ours

  send_cc(MIDI_CH, PUSH_CC_BASE + enc_num, 127)
end

function page.onPageChange(prev, curr)
  for i = 1, 16 do
    leds.reset(i)
    slots.reset(i)
  end
  if curr then
    send_cc(MIDI_CH, PAGE_CC, curr - 1)
  end
end

function controller.onSysex(bytes)
  -- SysEx framing: F0 00 7F 7F 01 <enc> <ring> <r> <g> <b> <c0> <c1> <c2> <c3> F7
  if not bytes or #bytes < 15 then return end
  if bytes[1] ~= 0xF0 or bytes[2] ~= 0x00 or bytes[3] ~= 0x7F or bytes[4] ~= 0x7F or bytes[5] ~= 0x01 then
    return
  end
  if bytes[#bytes] ~= 0xF7 then return end

  local enc  = bytes[6]
  local ring = bytes[7]
  local r    = bytes[8]
  local label = string.char(bytes[11], bytes[12], bytes[13], bytes[14])

  if enc == 0x7F then
    page.setTitle(label .. " " .. VERSION)
  elseif enc >= 0 and enc < 16 then
    local slot = enc + 1
    slots.update(slot, label)

    -- LED ring position (0-127 -> 0-16383)
    local ring_val = (ring * 16383) // 127

    -- Colour value 0-100 (leds.update's range in practice; the API doc's 0-15 is wrong)
    local color = r
    if color > 100 then color = 100 end
    leds.update(slot, ring_val, color)
  end
end
